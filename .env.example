# Listen on loopback unless a trusted reverse proxy or private network requires otherwise.
HOST=127.0.0.1
PORT=8787

# Exact, case-sensitive WhatsApp group subject. Duplicate names are rejected.
TARGET_GROUP_NAME=Family Codes

# Generate both with: npm run secrets
API_TOKEN=replace-with-generated-token
SESSION_ENCRYPTION_KEY=replace-with-generated-base64-key

SESSION_FILE=./data/session.enc
MAX_MESSAGE_LENGTH=1000
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
